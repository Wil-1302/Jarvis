// JARVIS — parche de configuración de OpenClaw (sin secretos). Lo aplica scripts/sync-brain.sh
// con `openclaw config patch --file`. Capa 1 del aislamiento: docs/AISLAMIENTO_OPENCLAW.md. D-008.
{
  agents: {
    defaults: {
      model: {
        // Sonnet: 1ª oración en 1,5 s frente a 3,7 s de Opus (mediana, streaming, 2026-11-17). Opus queda a mano por voz.
        primary: "anthropic/claude-sonnet-5-5",
        fallbacks: ["openai/gpt-5.6-terra"],     // respaldo ChatGPT (Codex OAuth). gpt-6-astra/sol no están en el plan del señor
      },
      models: {
        "anthropic/claude-sonnet-5-5": { agentRuntime: { id: "claude-cli" } },
        "anthropic/claude-opus-5-5": { agentRuntime: { id: "claude-cli" } },
      },
    },
    entries: {
      main: { workspace: "~/.openclaw/workspace" },
      jarvis: {
        name: "jarvis",
        workspace: "~/.openclaw/workspace-jarvis",
        agentDir: "~/.openclaw/agents/jarvis/agent",
        identity: { name: "JARVIS" },
        // Estricto (sin fallback nativo): el salto a GPT lo hace face y lo anuncia por voz (D-014).
        model: { primary: "anthropic/claude-sonnet-5-5", fallbacks: [] },
      },
      // D-023: agente ligero para la charla (instrucciones cortas, pocas herramientas) → menos latencia.
      charla: {
        name: "charla",
        workspace: "~/.openclaw/workspace-charla",
        agentDir: "~/.openclaw/agents/charla/agent",
        identity: { name: "JARVIS" },
        model: { primary: "openai/gpt-5.6-luna", fallbacks: [] },
        skills: ["abrir-aplicacion"],
        tools: { allow: ["exec", "read", "write", "edit", "group:web", "group:memory"] },
      },
    },
  },
  gateway: {
    bind: "loopback",
    http: { endpoints: { chatCompletions: { enabled: true } } },
  },
  tools: {
    // Refuerzo c: herramientas de archivos confinadas al workspace.
    fs: { workspaceOnly: true },
    exec: {
      applyPatch: { workspaceOnly: true },
      // Refuerzo a: solo la allowlist corre sin preguntar; lo demás pide aprobación humana (Control UI).
      security: "allowlist",
      ask: "on-miss",
      strictInlineEval: true,
    },
    // Refuerzo b: sin escape "elevated" ni autoaprobación de cambios de config por el propio agente.
    elevated: { enabled: false },
    openclaw: { autoApproveChanges: false },
    // gateway = reconfigurar OpenClaw; nodes/computer/terminal/screen = control directo del escritorio.
    deny: ["gateway", "group:nodes", "terminal", "screen", "browser"],
    // security audit: cada agente ve solo sus sesiones; sin mensajes entre agentes.
    sessions: { visibility: "agent" },
    agentToAgent: { enabled: false },
  },
  browser: { enabled: false },
}
