{
  "version": 1,
  "defaults": { "security": "allowlist", "ask": "on-miss", "askFallback": "deny", "autoAllowSkills": false },
  "agents": {
    "main":   { "security": "deny", "ask": "always", "askFallback": "deny", "autoAllowSkills": false },
    "jarvis": {
      "security": "allowlist", "ask": "on-miss", "askFallback": "deny", "autoAllowSkills": false,
      "allowlist": [
        { "pattern": "~/Proyectos/Jarvis/scripts/bin/jarvis-abrir", "argPattern": "^[A-Za-z0-9ÁÉÍÓÚÜÑáéíóúüñ .+-]{1,60}$" },
        { "pattern": "~/Proyectos/Jarvis/scripts/bin/jarvis-documento", "argPattern": "^documentos/[A-Za-z0-9._-]{1,80}\\.(html|txt) [A-Za-z0-9ÁÉÍÓÚÜÑáéíóúüñ _-]{1,60}$" },
        { "pattern": "/usr/bin/playerctl", "argPattern": "^(-p [A-Za-z0-9_.-]+ )?(play|pause|play-pause|next|previous|stop|status|metadata( --format [^;&|`$<>]{1,200})?)$" },
        { "pattern": "/usr/bin/wpctl", "argPattern": "^(get-volume @DEFAULT_AUDIO_SINK@|set-volume( -l 1(\\.0)?)? @DEFAULT_AUDIO_SINK@ [0-9]{1,3}(\\.[0-9]+)?%?[+-]?|set-mute @DEFAULT_AUDIO_SINK@ (0|1|toggle))$" },
        { "pattern": "/usr/bin/notify-send" }
      ]
    }
  }
}
