#!/usr/bin/env python3
"""Activa JARVIS sin wake word (atajo Super+J). Uso: jarvis-escucha [listen|stop]"""
import os, socket, subprocess, sys
sock = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "jarvis", "face.sock")
cmd = (sys.argv[1] if len(sys.argv) > 1 else "listen").encode()
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.settimeout(2); s.connect(sock); s.sendall(cmd + b"\n"); s.recv(8)
except OSError:
    subprocess.run(["notify-send", "-a", "JARVIS", "JARVIS", "face no está en marcha (systemctl --user start jarvis-face)"])
    sys.exit(1)
