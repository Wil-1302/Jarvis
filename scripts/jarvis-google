#!/usr/bin/env bash
# JARVIS — cuentas de Google (D-029). No muestra tokens.
#   jarvis-google login personal    ⏸ el señor inicia sesión con su cuenta PERSONAL (calendario, lectura y escritura)
#   jarvis-google login escuela     ⏸ el señor inicia sesión con su cuenta INSTITUCIONAL (Classroom + calendario, solo lectura)
#   jarvis-google check             ¿siguen valiendo los dos tokens? (lo usa doctor.sh; solo lectura)
set -uo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"
G="$HOME/.config/jarvis/google"
LIB="$HOME/.local/lib/jarvis-mcp/google-calendar/node_modules/@cocal/google-calendar-mcp/build/index.js"
PY="$REPO/face/.venv/bin/python"; [[ -x $PY ]] || PY=python3
[[ -f $G/oauth-client.json ]] || { echo "Falta $G/oauth-client.json (ver mcp/calendario.md)"; exit 1; }

check_personal() {
  local r
  r=$(cd "$REPO/face" && "$PY" -I -c '
import sys; sys.path.insert(0, ".")
from jarvis.mcp_cliente import Cliente, CALENDARIO
r = Cliente(CALENDARIO, timeout=20).herramienta("list-calendars")
cals = r.get("calendars", []) if isinstance(r, dict) else []
print(f"OK {len(cals)} calendario(s)" if cals else f"ERROR {str(r)[:200]}")' 2>&1 | tail -1)
  echo "$r"; [[ $r == OK* ]]
}

case "${1:-} ${2:-}" in
  "login personal")
    echo "Se abrirá el navegador: elija su cuenta PERSONAL (la del celular) y acepte el permiso de Calendar."
    echo "Si sale «Google no ha verificado esta aplicación»: Configuración avanzada → Ir a … (es su propia app)."
    GOOGLE_OAUTH_CREDENTIALS="$G/oauth-client.json" GOOGLE_CALENDAR_MCP_TOKEN_PATH="$G/calendario-tokens.json" \
      GOOGLE_ACCOUNT_MODE=personal node "$LIB" auth personal || exit 1
    chmod 600 "$G/calendario-tokens.json"
    systemctl --user restart jarvis-calendario.service; sleep 3; check_personal ;;
  "login escuela")
    python3 -I "$REPO/mcp/escuela/servidor.py" login; r=$?
    systemctl --user restart jarvis-escuela.service; exit $r ;;
  "check "*)
    printf 'personal: '; check_personal; a=$?
    printf 'escuela:  '; python3 -I "$REPO/mcp/escuela/servidor.py" check; b=$?
    exit $((a || b)) ;;
  *) sed -n 2,5p "$0"; exit 2 ;;
esac
