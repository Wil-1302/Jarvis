# Plantilla: los secretos reales viven en ~/.config/jarvis/secrets.env (600, carpeta 700), fuera del repo
# y fuera del alcance del gateway (refuerzo a). Aquí solo van los NOMBRES de las variables, siempre vacíos.

# --- Puente face -> OpenClaw Gateway (solo loopback 127.0.0.1) ---
# El token del gateway equivale a acceso total de operador: trátalo como una contraseña.
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_BASE_URL=
# Agente destino, p. ej. openclaw/jarvis (verificar con GET /v1/models)
OPENCLAW_AGENT=
# Valor estable del campo "user" para conservar la sesión
OPENCLAW_SESSION_USER=

# --- Proveedores de modelos (los usa OpenClaw, no face) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=

# --- MCP (Fase 6) ---
GITHUB_PERSONAL_ACCESS_TOKEN=
RENDER_API_KEY=
AWS_PROFILE=
AWS_REGION=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
GOOGLE_OAUTH_CREDENTIALS=

# --- Voz (D-012): Azure Speech oficial, solo si se activa tts.engine: azure ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
