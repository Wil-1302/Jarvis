# Copia este fichero como .env y ajusta lo que necesites.
# .env NO se versiona. Nunca pongas secretos en .env.example.
# Las variables vacías se ignoran y se usa el valor de config/jarvis.toml.

# --- Identidad ---
JARVIS_NAME=Jarvis
JARVIS_LANGUAGE=es
JARVIS_WAKE_WORD=jarvis
JARVIS_ENV=development

# --- Workspace (vacío = raíz del proyecto) ---
JARVIS_WORKSPACE=

# --- Cerebro ---
JARVIS_LLM_PROVIDER=hybrid
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=
CLAUDE_COMMAND=claude

# --- Logging ---
JARVIS_LOG_LEVEL=INFO

# --- Permisos ---
JARVIS_ALLOW_SHELL=false
JARVIS_ALLOW_FILE_WRITE=false
JARVIS_REQUIRE_CONFIRMATION=true

# --- Audio (vacío = predeterminado de Windows; índice o parte del nombre) ---
JARVIS_AUDIO_INPUT_DEVICE=
JARVIS_AUDIO_OUTPUT_DEVICE=

# --- Voz ---
JARVIS_WAKE_ENGINE=hybrid
JARVIS_WAKE_THRESHOLD=0.5
JARVIS_STT_MODEL=large-v3-turbo
# cpu si la GPU está ocupada (p. ej. jugando):
JARVIS_STT_DEVICE=auto
JARVIS_TTS_VOICE=es_MX-ald-medium
JARVIS_ECHO_COOLDOWN_MS=400

# --- Health check ---
JARVIS_CHECK_GITHUB=true
# Ruta absoluta a ffmpeg.exe si no está en el PATH:
JARVIS_FFMPEG_PATH=

# --- Credenciales futuras (todavía NO se usan) ---
# Claude Code usa el login de tu suscripción; NO definas ANTHROPIC_API_KEY
# salvo que quieras facturar por API (tiene prioridad sobre la suscripción).
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
